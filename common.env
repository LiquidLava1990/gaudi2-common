# Shared serving config (sourced by serve.sh)
IMAGE=vllm-gaudi:1.24
BASE_IMAGE=vault.habana.ai/gaudi-docker/1.24.0/ubuntu24.04/habanalabs/pytorch-installer-2.9.0:latest
MODELS_DIR=/mnt/fastmodels
RECIPE_CACHE=/mnt/data1/recipe_cache
QUANT_DIR=/mnt/data1/quant
BIND_IP=0.0.0.0                 # all interfaces — reachable over LAN + tailnet (keyless; keep box off the public internet)
PORT=8000
# API_KEY empty => vllm serves with NO auth (per "no api keys on anything" 2026-07-06). containers.sh
# only passes --api-key when this is non-empty. A keyless server still accepts requests that DO send an
# Authorization header (it just ignores it), so existing tooling keeps working; new callers need no key.
API_KEY=
CONTAINER=vllm-active           # single fixed name => only ONE model can run at a time

# ============================================================================================
# ENV-KNOB FINGERPRINT GUARD  (companion to the file-based STALE-RECIPE GUARD in serve.sh /
# containers.sh).  Closes the second stale-replay hole: recipe-cache validation is OFF
# (PT_HPU_RECIPE_CACHE_CONFIG=".../<key>,false,8192") for fast warm restarts, so a recipe is
# replayed verbatim whenever its key matches — EVEN IF a *compute-selecting env var changed
# between serves*.  Those knobs (HPU_MOE_*, HPU_LAYER_FUSE, HPU_AR_NO_MARKSTEP, MODERN_MOE_EXEC,
# MMEL_*, PT_HPU_LAZY_MODE, num_experts_per_tok/hf-overrides, ...) are read at MODULE IMPORT into
# globals that decide WHICH GRAPH is captured.  The file-based guard only wipes on a newer .py/.so;
# it does NOT see an env-only flip.  So an A/B that flips a knob against a warm cache REPLAYS THE OLD
# GRAPH -> identical step time -> the change silently never takes effect (this masked real levers;
# every env-only A/B against a warm cache was contaminated).  This guard fingerprints exactly the
# compute-affecting knobs THIS serve passes and wipes the cache (rewriting a sentinel) only when
# that fingerprint changes.  Sourced by BOTH serve paths; functions are inert until called.
#
# Whitelist = knobs that change the captured graph.  DELIBERATELY EXCLUDED: volatile/telemetry keys
# (HPU_STEP_TIMER*, HPU_PROFILE_*, HPU_*_DUMP*, *_GRAFT/REPACK paths, VLLM_*_TIMEOUT*, log toggles)
# so a benign env diff does NOT cold-wipe a good warm cache.
__MMEL_ENVKNOB_RE='HPU_MOE_FUSED_OP|HPU_MOE_FUSED_BATCHED|HPU_MOE_FUSED_MONOLITHIC|HPU_MOE_FUSED_MONOLITHIC_CHUNK|HPU_MOE_FUSED_MONO_MARKSTEP|HPU_MOE_FUSED_X_BUFFER|HPU_MOE_FUSED_X_BUF_T|HPU_MOE_FUSED_VERIFY|HPU_MOE_ROUTED_K|HPU_MOE_ROUTED_KBUCKET|HPU_MOE_ROUTED_BSGT1|HPU_MOE_ROUTED_MAX_T|HPU_MOE_ROUTED_VERIFY|HPU_MOE_FP8_EXPERTS|HPU_MOE_FP8_EXPERTS_VERIFY|HPU_MOE_FP8_FUSED|HPU_MOE_FP8_DIRECT|HPU_MOE_FP8_FREE_INT4|HPU_FP8_KV_BF16_ATTN|HPU_FP8_ATTN_[A-Z0-9_]+|HPU_LAYER_FUSE|HPU_AR_NO_MARKSTEP|HPU_ASYNC_SPEC|HPU_DSA_SPARSE|HPU_FSDPA_BIAS_AUTHORITATIVE|HPU_TREE_VERIFY|HPU_TREE_VERIFY_KVCOMMIT|HPU_TREE_BUDGET|HPU_TREE_WIDTHS|HPU_SKIP_MOE_LAYERS|HPU_SKIP_LAYERS|HPU_MOE_FUSED_MONO_INT4FP8|HPU_MOE_FUSED_MONO_MAX_T|HPU_MOE_ROUTED_SEQ_OFFSET_CLONE|USE_KVQ|HPU_KVQ_[A-Z0-9_]+|HPU_MLA_KV_[A-Z0-9_]+|M3_EXPERT_RUNTIME|M3_SWIGLUOAI|M3_FP8_STATIC|M3_FP8_SWIGLU_ROUTE|M3_FP8_MME|M3_FP8_NOTRANSPOSE|M3_FP8_MONO_CHUNK|M3_FP8_MONO_MARKSTEP|M3_MOE_FUSE|M3_GROUPED_CAP|M3_GROUPED_TMAX|MAX_EXPERTS_PER_SLICE|MODERN_MOE_EXEC|MODERN_MOE_EXEC_FAMILIES|MMEL_[A-Z0-9_]+|PT_HPU_LAZY_MODE|PT_HPU_ENABLE_LAZY_COLLECTIVES|HPU_MOE_REAP_PROBE'

# envknob_fingerprint <MODEL_ENV> <VLLM_ARGS> -> prints the sorted "KEY=VAL" compute-knob list.
# Pulls whitelisted "-e KEY=VAL" tokens out of the *resolved* MODEL_ENV (so MODEL_ENV_EXTRA-injected
# knobs are included) plus the complete resolved VLLM_ARGS string. Serving args
# select graph/eager mode, bucket shapes, TP/EP, quantization and KV layout; a
# stale recipe is unsafe whenever any of them changes. Hashing the full string
# favors one conservative recompile over a silently contaminated A/B/deploy.
# set -e safe: each grep is guarded with `|| true`, all inside a subshell, terminated by sort.
envknob_fingerprint() {
  local model_env="${1:-}" vllm_args="${2:-}" nept
  (
    # shellcheck disable=SC2086  -- intentional word-split of the "-e KEY=VAL ..." string into tokens
    printf '%s\n' $model_env | grep -oE "^(${__MMEL_ENVKNOB_RE})=[^ ]*$" || true
    printf 'VLLM_ARGS=%s\n' "$vllm_args"
    nept=$(printf '%s' "$vllm_args" | grep -oE '"num_experts_per_tok"[[:space:]]*:[[:space:]]*[0-9]+' | grep -oE '[0-9]+$' | head -1 || true)
    [ -n "$nept" ] && echo "num_experts_per_tok=$nept" || true
  ) | LC_ALL=C sort -u
}

# envknob_guard <cache_dir> <label> <MODEL_ENV> <VLLM_ARGS>
#   Wipes the recipe files in <cache_dir> (preserving the dotfile sentinel) iff the compute-knob
#   fingerprint differs from the recorded sentinel.  First-ever serve records the sentinel WITHOUT
#   wiping (a fresh cache has nothing stale).  Composes with the file-based guard: both only remove
#   non-dotfile recipes, so they never double-wipe destructively and the sentinel always survives.
#   set -e safe (no command can abort the caller).  CPU/code only — touches files, never the device.
envknob_guard() {
  local cache_dir="${1:?envknob_guard needs cache_dir}" label="${2:?envknob_guard needs label}"
  local model_env="${3:-}" vllm_args="${4:-}"
  local sentinel="$cache_dir/.envknobs_hash" fp cur_hash old_hash
  [ -d "$cache_dir" ] || return 0
  fp="$(envknob_fingerprint "$model_env" "$vllm_args")"
  cur_hash="$(printf '%s' "$fp" | sha256sum | cut -c1-16)"
  if [ -f "$sentinel" ]; then old_hash="$(cat "$sentinel" 2>/dev/null || true)"; else old_hash=""; fi
  if [ -z "$old_hash" ]; then
    printf '%s\n' "$cur_hash" > "$sentinel" 2>/dev/null || true
    echo "ENV-KNOB GUARD: first compute-knob fingerprint for $label = $cur_hash (recorded; no wipe)"
    return 0
  fi
  if [ "$old_hash" != "$cur_hash" ]; then
    echo "ENV-KNOB CHANGE detected for $label -> wiping stale recipes (was $old_hash now $cur_hash)"
    echo "  compute knobs now: $(printf '%s' "$fp" | tr '\n' ' ')"
    find "$cache_dir" -mindepth 1 -maxdepth 1 ! -name '.envknobs_hash' -exec rm -rf {} + 2>/dev/null || true
    printf '%s\n' "$cur_hash" > "$sentinel" 2>/dev/null || true
  fi
  return 0
}
