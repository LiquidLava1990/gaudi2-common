# Qwen3.5-397B-A17B-GPTQ-Int4  —  TP=8 LAZY throughput, STOCK monolithic int4-MoE op
# ============================================================================
# THE A/B "stock" BASELINE arm: byte-identical to qwen35-397b-fused-monolithic.env
# EXCEPT HPU_MOE_FUSED_MONOLITHIC is NOT set, so apply_monolithic uses the STOCK
# VllmMixtureOfExpertsOpWNA16 (all-64-expert dequant -> bf16 -> HBM -> a separate
# torch.ops.hpu.mixture_of_experts gemm — the ~99us/token bf16->HBM round-trip floor at
# concurrency). Same --max-num-seqs 16, same everything else, so the ONLY variable
# between this and the fused arm is the MoE op. Run BOTH and compare aggregate tok/s at
# matched concurrency to isolate the fusion win.
#
# (qwen35-397b-tp8-lazy-throughput.env is the max-aggregate stock profile at
# --max-num-seqs 256; THIS env matches the fused arm's 16 for a clean single-variable
# A/B. Use that one for the absolute-throughput-ceiling point.)
#
# LAUNCH:  ./serve.sh qwen35-397b-stock-monolithic
IMAGE=vllm-gaudi:next
MODEL_PATH=Qwen3.5-397B-A17B-GPTQ-Int4
SERVED_NAME=qwen35-397b
MODEL_ENV="-e PT_HPU_LAZY_MODE=1 -e PT_HPU_WEIGHT_SHARING=0 -e PT_HPU_ENABLE_LAZY_COLLECTIVES=true -e HPU_MARKSTEP_LAZY_ONLY=1 -e VLLM_ENGINE_ITERATION_TIMEOUT_S=900 -e VLLM_RPC_TIMEOUT=100000000 -e VLLM_GRAPH_RESERVED_MEM=0.2"
VLLM_ARGS="--quantization gptq_hpu --tensor-parallel-size 8 --enable-expert-parallel --max-model-len 8192 --max-num-seqs 16 --gpu-memory-utilization 0.9 --block-size 128 --async-scheduling --no-enable-prefix-caching --trust-remote-code"
