# Qwen3.5-397B-A17B-GPTQ-Int4  —  TP=8 LAZY + lazy-collectives, HIGH-CONCURRENCY throughput
# ----------------------------------------------------------------------------
# One TP=8 EP instance on all 8 cards, run under LAZY mode so the TP all-reduces are
# CAPTURED IN the HPUGraph (lazy collectives) instead of host-launched + synced every
# call. Pairs with patches/lazy_collectives_allreduce.patch, which gates the
# HpuCommunicator.all_reduce mark_step on is_lazy() to MIRROR combine() — so the
# pre-collective sync is paid ONCE at graph capture, not per-token. This deletes the
# ungraphed all-reduce "tax" (the ~2 RowParallel reductions/layer * N layers that
# otherwise serialize a 0%-util, sync-bound decode), which is the second throughput
# lever after DP2xTP4.
#
# LAUNCH (single instance via serve.sh):
#     ./serve.sh qwen35-397b-tp8-lazy-throughput
# Then sweep concurrency live (below). Use this for the SINGLE-instance high-load
# point; use qwen35-397b-dp2tp4 for the max-aggregate (2x TP4 replica) point.
#
# LAZY mode (PT_HPU_LAZY_MODE=1) requires the lazy image (vllm-gaudi:next); the eager
# :1.24 base AssertionErrors on PT_HPU_LAZY_MODE=1. Under lazy, vllm-gaudi's
# set_torch_compile() force-sets PT_HPU_ENABLE_LAZY_COLLECTIVES=true; we set it
# explicitly too. The all_reduce patch's is_lazy() guard KEEPS the mark_step here (it
# is the in-graph-collective boundary lazy needs) — identical to combine() — while the
# torch.compile path would skip it. HPU_MARKSTEP_LAZY_ONLY=1 is the equivalent runtime
# toggle the bundled plugin (__init__.py _install_communicator_patch) applies if the
# file patch is not present; set as a belt-and-suspenders.
#
# TP=8 EP -> 128/8 = 16 experts/card, 27.5GB weights/card -> ample HBM for graphs + a
# big KV pool (the headroom that lets concurrency climb; TP=4 lazy OOMs in graph
# capture). NO single-stream levers here (this is the throughput, not latency, profile):
# the monolithic VllmMixtureOfExpertsOpWNA16 serves bs>1; HPU_MOE_ROUTED_K is a batch=1
# gather and is intentionally UNSET. Prefix caching OFF (Qwen3.5 GDN/mamba chunk-align
# crash @C>=100). max-num-seqs 256 + 8K ctx = high-concurrency profile.
#
# Benefits from patches/dp_ep_dispatch_fix.patch (authoritative expert_map remap), which
# is correct for plain TP=8 EP too (the map is contiguous there) — safe to keep applied.
IMAGE=vllm-gaudi:next
MODEL_PATH=Qwen3.5-397B-A17B-GPTQ-Int4
SERVED_NAME=qwen35-397b
MODEL_ENV="-e PT_HPU_LAZY_MODE=1 -e PT_HPU_WEIGHT_SHARING=0 -e PT_HPU_ENABLE_LAZY_COLLECTIVES=true -e HPU_MARKSTEP_LAZY_ONLY=1 -e VLLM_ENGINE_ITERATION_TIMEOUT_S=900 -e VLLM_RPC_TIMEOUT=100000000 -e VLLM_GRAPH_RESERVED_MEM=0.2"
VLLM_ARGS="--quantization gptq_hpu --tensor-parallel-size 8 --enable-expert-parallel --max-model-len 8192 --max-num-seqs 256 --gpu-memory-utilization 0.9 --block-size 128 --async-scheduling --no-enable-prefix-caching --trust-remote-code"
