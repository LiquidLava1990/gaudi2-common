+# ============================================================================
+# DP+EP global<->local expert-id mapping  (root-cause fix; see block below)
+# ============================================================================
+# ROOT CAUSE (the IndexError that BLOCKS DP2xTP4 — "a GLOBAL expert id indexing a
+# LOCAL <local_num_experts>-element parameter"):
+#
+#   This method shards experts with EXPERT-PARALLEL: every rank holds only
+#   `layer.local_num_experts` of the `global_num_experts` experts, and the HPU
+#   `mixture_of_experts` op + the stacked w13/w2/scales params are sized to that
+#   LOCAL count (e.g. 32 at TP=4, or 16 under DP2xTP4 flatten). The router still
+#   emits GLOBAL expert ids in [0, global_num_experts), so before the op runs we
+#   must map each GLOBAL id to this rank's LOCAL slot [0, local_num_experts) (or
+#   drop it as "not mine").
+#
+#   The ORIGINAL code derived that mapping from a HARDCODED contiguous-linear
+#   assumption:
+#         ep_shift     = layer.ep_rank * layer.local_num_experts
+#         experts_min  = ep_shift
+#         local_id     = global_id - experts_min            # in apply/_routed_moe
+#   i.e. it ASSUMES this rank owns the contiguous global block
+#   [ep_rank*E, ep_rank*E + E). That is true ONLY for placement_strategy="linear"
+#   with global_num_experts % ep_size == 0 AND when ep_rank*E equals the start
+#   index ExpertMapManager actually baked into `layer.expert_map`.
+#
+#   Under DATA-PARALLEL + EP that assumption BREAKS. vLLM's FusedMoEParallelConfig
+#   FLATTENS expert-parallel across DP x TP (config.py: `ep_size = dp_size*tp_size`,
+#   `ep_rank = dp_rank*tp_size + tp_rank`), while each DP replica is a SEPARATE
+#   engine that only initialises its own TP process group. So `layer.ep_rank`
+#   (flattened) and the per-replica `layer.expert_map`'s real start index no
+#   longer satisfy  start_idx == ep_rank * local_num_experts. The subtract-emin
+#   remap then yields a LOCAL id OUTSIDE [0, local_num_experts) for genuinely-
+#   routed experts -> that id indexes the LOCAL-sized op weight list / stacked
+#   param out of range -> IndexError at load/first-forward (and, where it doesn't
+#   raise, silently wrong experts). EP-only (no DP) happens to satisfy the
+#   contiguous assumption, which is why it worked and DP2xTP4 did not.
+#
+# FIX: stop re-deriving the window arithmetically. `layer.expert_map` is the
+# AUTHORITATIVE [global_num_experts] int32 buffer that ExpertMapManager built and
+# that the upstream weight-loader ALREADY used to PLACE these weights:
+#       expert_map[g] = local_id in [0, local_num_experts)   if g is on this rank
+#       expert_map[g] = -1                                   otherwise
+# Mapping GLOBAL->LOCAL by gathering through expert_map is correct for linear,
+# round_robin, contiguous AND the DP+EP flattened layout, by construction (it is
+# the same map the weights were loaded with). We stash it on the layer and use a
+# gather-based remap in apply_monolithic / _routed_moe. The old ep_shift formula
+# is kept ONLY as the fallback for the no-EP case (expert_map is None, ep_size==1),
+# where experts_min is 0 and global==local anyway.
+
+def _ep_remap_meta(layer):
+    """Return (experts_min, expert_map_or_None) for this rank under EP.
+
+    expert_map (when not None) is the authoritative [global_num_experts] int32
+    buffer with expert_map[g] = local_id or -1. experts_min is the smallest
+    GLOBAL id this rank owns (informational / probe + the subtract-emin fallback).
+
+    Prefers layer.expert_map. Falls back to the contiguous formula
+    ep_rank*local_num_experts ONLY when no expert_map exists (EP disabled)."""
+    E = int(layer.local_num_experts)
+    emap = getattr(layer, "expert_map", None)
+    if emap is not None:
+        owned = (emap >= 0).nonzero().flatten()
+        # smallest global id mapped to a local slot; 0 if (defensively) none.
+        experts_min = int(owned[0].item()) if owned.numel() > 0 else 0
+        return experts_min, emap
+    # No EP (ep_size == 1): global ids ARE local ids; contiguous formula degenerates
+    # to ep_rank(0)*E = 0. Keep ep_rank*E for any exotic no-map EP path.
+    experts_min = int(getattr(layer, "ep_rank", 0)) * E
+    return experts_min, None
+
+
+def _remap_global_to_local(tid, tw, layer):
+    """Map GLOBAL expert ids `tid` -> this rank's LOCAL slots, zeroing the router
+    weight `tw` for non-local experts so they contribute exactly 0 (mirrors the
+    out-of-window-id handling). Returns (local_tid, masked_tw).
+
+    Uses the stashed authoritative expert_map (`_hpu_expert_map`) when present:
+    a gather `expert_map[global_id]` gives the true local id (or -1); -1 entries
+    are remapped to local slot 0 with weight zeroed. Correct for ANY placement /
+    flatten. Without a map (no EP), `tid` already is local."""
+    import torch as _torch
+    emap = getattr(layer, "_hpu_expert_map", None)
+    if emap is None:
+        return tid, tw  # no EP: global == local
+    tid64 = tid.to(_torch.int64)
+    if emap.device != tid64.device:
+        emap = emap.to(tid64.device)
+        layer._hpu_expert_map = emap  # cache the moved copy
+    G = emap.shape[0]
+    in_range = (tid64 >= 0) & (tid64 < G)
+    safe_gid = _torch.where(in_range, tid64, _torch.zeros_like(tid64))
+    local = emap.to(_torch.int64).index_select(0, safe_gid.reshape(-1)).view_as(tid64)
+    is_local = in_range & (local >= 0)               # -1 (not mine) or out-of-range -> drop
+    local_tid = _torch.where(is_local, local, _torch.zeros_like(local))
+    masked_tw = _torch.where(is_local, tw, _torch.zeros_like(tw))
+    return local_tid, masked_tw
+
